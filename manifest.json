{
  "manifest_version": 3,
  "name": "AutoSort+",
  "version": "1.2.4.0",
  "description": "__MSG_extensionDescription__",
  "author": "Nigel Hagen",
  "applications": {
    "gecko": {
      "id": "autosortplus@nigelhagen.com",
      "strict_min_version": "115.0"
    }
  },
  "default_locale": "en",
  "permissions": [
    "messagesRead",
    "messagesModify",
    "accountsRead",
    "storage",
    "menus",
    "tabs",
    "messagesMove",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["js/logger.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "__MSG_extensionDefaultTitle__"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "api_ollama/index.html",
        "api_ollama/ollama-popup.js",
        "js/ollama.js",
        "js/workers/ollama-worker.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
